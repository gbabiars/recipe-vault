{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "runId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "sequence": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "from": {
      "type": "string",
      "enum": [
        "intake",
        "plan",
        "verify-plan",
        "implementation",
        "verify-fix",
        "review",
        "open-pr",
        "human-review",
        "complete"
      ]
    },
    "to": {
      "type": "string",
      "enum": [
        "intake",
        "plan",
        "verify-plan",
        "implementation",
        "verify-fix",
        "review",
        "open-pr",
        "human-review",
        "complete"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": ["pass", "return", "retry", "blocked", "complete"]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:^|\\/)\\.\\.(?:\\/|$))[A-Za-z0-9][A-Za-z0-9._/-]*$"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "approval": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "string",
          "enum": ["spec.md", "plan.md"]
        },
        "revision": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "decision": {
          "type": "string",
          "const": "approved"
        },
        "source": {
          "type": "string",
          "const": "human-chat"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["artifact", "revision", "decision", "source", "statement", "sha256"],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "sequence",
    "from",
    "to",
    "outcome",
    "artifacts",
    "evidence",
    "findings",
    "attempt"
  ],
  "additionalProperties": false
}
