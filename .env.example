# Public Supabase project configuration. Values may be included in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Server-only, comma-separated allow-list of pre-registered MCP OAuth clients.
# Use dedicated Codex and ChatGPT staging client IDs when their redirect URIs differ.
# These are OAuth client identifiers, never tokens or Supabase API keys.
MCP_TRUSTED_OAUTH_CLIENT_IDS=your-codex-client-id,your-chatgpt-client-id
# Legacy one-client fallback. Prefer MCP_TRUSTED_OAUTH_CLIENT_IDS for new deployments.
# MCP_TRUSTED_OAUTH_CLIENT_ID=your-pre-registered-client-id
# The UUID of the single private owner permitted to consent and use MCP.
RECIPE_VAULT_OWNER_ID=your-private-owner-user-id

# Server-only Supabase configuration. Do not prefix this variable with NEXT_PUBLIC_.
# Leave unset unless a future server-only operation explicitly needs it.
# SUPABASE_SERVICE_ROLE_KEY=
