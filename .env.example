# Default remote Supabase project configuration. Values may be included in browser bundles.
# `pnpm dev` uses this file through `.env.local`.
# See the Local development section in README.md for the local database override.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Public Clerk configuration. It is safe for browser bundles.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Public Sentry project DSN. Safe to include in the browser bundle.
NEXT_PUBLIC_SENTRY_DSN=https://bb94d239389bd3ea67b0a597ebad8aa6@o4512096219365376.ingest.us.sentry.io/4512167685193728

# Optional server-side alias for the same DSN.
SENTRY_DSN=

# Optional build-time token for uploading source maps and creating releases.
# Keep the real token in local/hosting secrets; never commit it.
SENTRY_AUTH_TOKEN=

# Server-only Clerk configuration. Do not prefix secrets with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# Required for server-side MCP data access after Clerk OAuth verification.
# Never expose this key in browser code, MCP responses, or error messages.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
