# Public Supabase project configuration. Values may be included in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase configuration. Do not prefix this variable with NEXT_PUBLIC_.
# Leave unset unless a future server-only operation explicitly needs it.
# SUPABASE_SERVICE_ROLE_KEY=
