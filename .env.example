# Public Supabase project configuration. Values may be included in browser bundles.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key

# Public Clerk configuration. It is safe for browser bundles.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Server-only Clerk configuration. Do not prefix secrets with NEXT_PUBLIC_.
CLERK_SECRET_KEY=sk_test_your-clerk-secret-key

# The single private Clerk user ID (for example, user_abc123). It is checked by
# browser/API access and by the MCP API-key adapter.
RECIPE_VAULT_OWNER_ID=user_your_private_owner

# Required only by /api/mcp after Clerk API-key verification. This credential
# never enters browser code and is never accepted from an MCP client.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-supabase-service-role-key
