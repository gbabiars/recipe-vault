{
  "name": "recipe-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm mcp:build-view && next dev",
    "dev:local": "pnpm mcp:build-view && node --env-file=.env.local-db ./node_modules/next/dist/bin/next dev",
    "mcp:build-view": "tsx scripts/build-mcp-recipe-view.ts",
    "prepare": "git config core.hooksPath .githooks",
    "build": "pnpm mcp:build-view && next build",
    "start": "next start",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:components && pnpm test:storybook",
    "test:unit": "node --import tsx --test tests/**/*.test.ts",
    "test:components": "vitest run --project components",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:mcp:openai": "tsx scripts/mcp-openai-smoke.ts",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "test:db": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/recipe_rls_verification.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/tags_verification.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/mcp_tag_inventory.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/mcp_unused_tag_cleanup.sql && psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f supabase/tests/mcp_tag_merge.sql && bash supabase/tests/tags_concurrency.sh && bash supabase/tests/mcp_unused_tag_cleanup_concurrency.sh && bash supabase/tests/mcp_tag_merge_concurrency.sh",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@clerk/mcp-tools": "^0.6.0",
    "@clerk/nextjs": "^7.9.4",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@sentry/nextjs": "^11.0.0",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.119",
    "cn": "^0.3.0",
    "launchdarkly-react-client-sdk": "^3.9.4",
    "lucide-react": "^1.47.0",
    "mcp-handler": "^1.1.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.1",
    "@csstools/postcss-global-data": "^4.0.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-mcp": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint-plugin-storybook": "^10.6.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "playwright": "^1.63.0",
    "postcss-flexbugs-fixes": "^5.0.2",
    "postcss-preset-env": "^11.5.3",
    "storybook": "^10.6.0",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.23.0"
}
